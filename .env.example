# Public HTTPS URL from Cloudflare Tunnel, configured in BotFather.
# Example: https://news-abc.trycloudflare.com
MINI_APP_URL=https://your-domain.example
TELEGRAM_BOT_TOKEN=
PORT=8080
DATABASE_PATH=/data/news.db
RSS_FETCH_INTERVAL=10m
# Public user agent used when fetching the linked article body for RSS items.
RSS_CONTENT_USER_AGENT=TelegramNewsRSSBot/1.0
# Translate and cache the title/summary in Vietnamese while importing new RSS items.
RSS_TRANSLATE_VI=true
TELEGRAM_AUTH_MAX_AGE=24h
# OpenAI-compatible Chat Completions endpoint. Leave AI_KEY empty to disable AI summaries.
AI_URL=https://api.openai.com/v1/chat/completions
AI_KEY=
AI_MODEL=gpt-4o-mini
# Set to true only while developing outside Telegram.
DEV_AUTH=false
DEV_USER_ID=999001
